// Base settings for the Nardi app target. Supabase credentials live in the
// gitignored Supabase.xcconfig, written by `scripts/supabase_setup_wizard.sh --app-only`
// (or copy Supabase.example.xcconfig). When it is
// absent the uploader keeps finished games queued on disk and sends nothing.
#include? "Supabase.xcconfig"
